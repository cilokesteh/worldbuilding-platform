// Prisma schema — Worldbuilding Platform Fase 1 MVP
// PostgreSQL. Semua fitur gratis, tanpa subscription.
// TemplateField disimpan sebagai JSON di Template.fields (tipe, label, wajib,
// opsi dropdown, urutan) — setara JSONB untuk field dinamis.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  CONTRIBUTOR
  REVIEWER
  VIEWER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  PRIVATE
}

enum TokenType {
  VERIFY
  RESET
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  avatarMediaId  String?
  emailVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspacesOwned Workspace[]        @relation("WorkspaceOwner")
  memberships      WorkspaceMember[]
  articlesCreated  Article[]          @relation("ArticleAuthor")
  versionsCreated  ArticleVersion[]
  comments         Comment[]
  mediaUploaded    MediaAsset[]
  tokens           EmailToken[]

  @@map("users")
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members WorkspaceMember[]
  worlds  World[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(VIEWER)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model World {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  genre       String?
  tags        String[] @default([])
  coverMediaId String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categories  Category[]
  templates   Template[]
  articles    Article[]
  relationships Relationship[]
  media       MediaAsset[]

  @@map("worlds")
}

model Category {
  id        String   @id @default(cuid())
  worldId   String
  name      String
  color     String?
  createdAt DateTime @default(now())

  world    World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  articles Article[]

  @@unique([worldId, name])
  @@map("categories")
}

model Template {
  id          String   @id @default(cuid())
  worldId     String?  // null = template bawaan global
  name        String
  description String?
  // fields: [{ key, label, type: text|longtext|number|date|dropdown|multiselect|checkbox|image|url|entity|repeater,
  //            required, options?, prompt?, order }]
  fields      Json     @default("[]")
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  world    World?    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  articles Article[]

  @@map("templates")
}

model Article {
  id          String        @id @default(cuid())
  worldId     String
  templateId  String?
  categoryId  String?
  title       String
  slug        String
  // content: Markdown. Template field values disimpan sebagai JSON di fieldValues.
  content     String        @default("")
  fieldValues Json          @default("{}")
  excerpt     String?
  status      ArticleStatus @default(DRAFT)
  coverMediaId String?
  wordCount   Int           @default(0)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  world      World            @relation(fields: [worldId], references: [id], onDelete: Cascade)
  template   Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author     User             @relation("ArticleAuthor", fields: [createdById], references: [id])
  versions   ArticleVersion[]
  comments   Comment[]
  relFrom    Relationship[]   @relation("RelFrom")
  relTo      Relationship[]   @relation("RelTo")

  @@unique([worldId, slug])
  @@index([worldId, status])
  @@map("articles")
}

model ArticleVersion {
  id          String   @id @default(cuid())
  articleId   String
  title       String
  content     String
  fieldValues Json     @default("{}")
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [createdById], references: [id])

  @@map("article_versions")
}

model Relationship {
  id            String   @id @default(cuid())
  worldId       String
  fromArticleId String
  toArticleId   String
  type          String   // Keluarga, Pertemanan, Rivalitas, Kemitraan, Musuh, Mentor/Murid, Anggota, dll (kustom)
  label         String?
  createdAt     DateTime @default(now())

  world World   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  from  Article @relation("RelFrom", fields: [fromArticleId], references: [id], onDelete: Cascade)
  to    Article @relation("RelTo", fields: [toArticleId], references: [id], onDelete: Cascade)

  @@unique([fromArticleId, toArticleId, type])
  @@map("relationships")
}

model MediaAsset {
  id          String   @id @default(cuid())
  worldId     String
  filename    String
  mimeType    String
  size        Int
  // Data file disimpan sebagai base64 di database (MVP, gratis, tanpa S3).
  data        String
  createdById String
  createdAt   DateTime @default(now())

  world    World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [createdById], references: [id])

  @@map("media_assets")
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  body      String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_tokens")
}
